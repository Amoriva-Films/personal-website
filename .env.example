# Vorlage für die Umgebungsvariablen dieser Website.
#
# Diese Datei enthält KEINE echten Schlüssel und darf im Repo liegen.
# Die echten Werte stehen in .env.local (lokal, wird nicht mitgeliefert)
# und bei Vercel unter Settings → Environment Variables.
#
# Kopieren mit:  cp .env.example .env.local


# ── Mailversand (Pflicht) ────────────────────────────────────────────
# Schlüssel von resend.com. Ohne ihn kann das Anfrageformular keine
# Mail verschicken und meldet dem Paar einen Fehler.
RESEND_API_KEY=


# ── Anfragen ins Amoriva-Dashboard (freiwillig) ──────────────────────
# Wenn gesetzt, landet jede Formular-Anfrage zusätzlich zur Mail im
# eigenen Amoriva-Dashboard, mit der Rückfrage „Von deiner Website:
# übernehmen? Ja / Nein".
#
# Woher der Wert kommt:
#   amoriva.app → Dashboard → Anfrageformular → „Website-Eingang"
#   Dort steht die vollständige Adresse. Sie endet auf einen Schlüssel,
#   der mit ws_ anfängt.
#
# Form:
#   https://amoriva.app/api/anfragen/eingang/ws_xxxxxxxxxxxxxxxxxxxxxxxx
#
# Wichtig:
#   - Der Schlüssel gehört NUR hierher, niemals in den Quellcode.
#   - Ist die Variable leer oder falsch geschrieben, läuft alles wie
#     bisher weiter, nur ohne Eintrag im Dashboard. Die Mail geht
#     immer raus, auch wenn Amoriva gerade nicht erreichbar ist.
#   - Bei Vercel für Production UND Preview setzen, sonst fehlt der
#     Anschluss auf Vorschau-Deployments.
AMORIVA_EINGANG_URL=


# ── Der Wächter (empfohlen) ──────────────────────────────────────────
# Passwort für die tägliche Selbstprüfung unter /api/waechter.
#
# Ohne diesen Wert bleibt der Wächter komplett geschlossen und antwortet
# jedem mit 503. Das ist Absicht: ein offener Endpunkt, der Mails
# verschickt, wäre ein Werkzeug für Fremde.
#
# Vercel schickt diesen Wert bei den eigenen Cron-Aufrufen automatisch
# mit, sobald die Variable dort gesetzt ist. Es muss nichts weiter
# eingerichtet werden.
#
# Woher der Wert kommt: frei erfunden, lang und zufällig. Zum Beispiel
# in einem Terminal:  openssl rand -hex 32
CRON_SECRET=

# Nach so vielen Tagen ohne eine einzige Anfrage meldet sich der Wächter
# einmal und erinnert daran, das Formular selbst zu testen. Danach alle
# sieben Tage erneut. Leer lassen heißt 14 Tage.
WAECHTER_STILLE_TAGE=

# Welche Adresse der Wächter prüft. Leer lassen heißt
# https://amoriva-films.de. Nur zum Testen auf einer Vorschau nötig.
WAECHTER_BASIS=
